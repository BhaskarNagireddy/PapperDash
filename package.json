{
  "name": "papperdash",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint . && node scripts/check-boundaries.mjs && node scripts/check-secrets.mjs",
    "dev:infra": "docker compose up -d",
    "dev:core": "pnpm --filter @papperdash/core dev",
    "test:coverage": "turbo run test:coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "turbo": "^2.11.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1"
  },
  "pnpm": {
    "overrides": {
      "body-parser@>=2.0.0 <2.4.0": "2.4.0",
      "multer@>=2.0.0 <2.5.0": "2.5.0",
      "qs@>=6.7.0 <6.16.1": "6.17.1",
      "source-map-js@>=1.0.0 <1.2.2": "1.2.2"
    }
  }
}

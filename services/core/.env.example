DATABASE_URL=postgres://papperdash:papperdash@localhost:5432/papperdash
PORT=4000
PUBLIC_WEB_URL=http://localhost:3000
COOKIE_SECURE=false
# JSON map of station ID -> shared key, used by station devices until mTLS lands (Phase 1s simulator).
STATION_KEYS={"lund-sim-1":"change-me-to-a-long-random-string"}
# Comma-separated OAuth client IDs whose ID tokens are accepted. Empty disables the provider.
GOOGLE_CLIENT_IDS=
# Apple bundle ID (iOS app) and Services ID (website).
APPLE_CLIENT_IDS=
